# ============================================================================
# Griffin Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys
# This project runs locally - all data stays on your machine
# ============================================================================

# ----------------------------------------------------------------------------
# LLM Provider (Required - choose ONE)
# ----------------------------------------------------------------------------
# LLM_PROVIDER selects which backend get_llm() uses. It must match the key and
# model you set below. Valid values: gemini, openrouter. The code default is
# openrouter, so set this explicitly to avoid a startup error.
LLM_PROVIDER=gemini

# Option 1: Google Gemini (Recommended)
# Get your API key at: https://aistudio.google.com/app/apikey
# Use LLM_PROVIDER=gemini with a bare model id like gemini-2.0-flash.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Option 2: OpenRouter (Alternative)
# Get your API key at: https://openrouter.ai/keys
# To use this, set LLM_PROVIDER=openrouter and a routed model id such as
# LLM_MODEL=google/gemini-2.0-flash-001.
# OPENROUTER_API_KEY=

# ----------------------------------------------------------------------------
# ML Service Configuration
# ----------------------------------------------------------------------------
ML_SERVICE_PORT=9100
NEXT_PUBLIC_ML_SERVICE_URL=ws://localhost:9100
# The chat and blueprint views read this name for the same socket endpoint.
NEXT_PUBLIC_ORCHESTRATOR_URL=ws://localhost:9100

# ----------------------------------------------------------------------------
# GitHub Integration (Optional - for auto-pushing code)
# ----------------------------------------------------------------------------
# Create a Personal Access Token at: https://github.com/settings/tokens
# Select 'repo' scope for full repository access
GITHUB_TOKEN=
GITHUB_OWNER=your_github_username

# ----------------------------------------------------------------------------
# Vercel Deployment (Optional - for auto-deployment)
# ----------------------------------------------------------------------------
# Create a token at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ----------------------------------------------------------------------------
# Application URLs
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
