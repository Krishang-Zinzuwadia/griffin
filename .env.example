# ============================================================================
# Griffin Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys
# This project runs locally - all data stays on your machine
# ============================================================================

# ----------------------------------------------------------------------------
# LLM Provider (Required - choose ONE)
# ----------------------------------------------------------------------------
# LLM_PROVIDER selects which backend get_llm() uses. It must match the key and
# model you set below. Valid values: gemini, openrouter. The code default is
# openrouter, so set this explicitly to avoid a startup error.
LLM_PROVIDER=gemini

# Option 1: Google Gemini (Recommended)
# Get your API key at: https://aistudio.google.com/app/apikey
# Use LLM_PROVIDER=gemini with a bare model id like gemini-2.0-flash.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Option 2: OpenRouter (Alternative)
# Get your API key at: https://openrouter.ai/keys
# To use this, set LLM_PROVIDER=openrouter and a routed model id such as
# LLM_MODEL=google/gemini-2.0-flash-001.
# OPENROUTER_API_KEY=

# ----------------------------------------------------------------------------
# ML Service Configuration (Bun ml-service, lightweight local dev)
# ----------------------------------------------------------------------------
ML_SERVICE_PORT=9100
NEXT_PUBLIC_ML_SERVICE_URL=ws://localhost:9100
# NEXT_PUBLIC_ORCHESTRATOR_URL is the WebSocket the frontend connects to. Point it
# at whichever backend you run. For local dev this is the Bun ml-service. For a
# deployed FastAPI backend use wss from an https site, e.g. wss://your-backend-host/ws
NEXT_PUBLIC_ORCHESTRATOR_URL=ws://localhost:9100

# ----------------------------------------------------------------------------
# FastAPI Backend Service (backend/api, recommended for deployment)
# ----------------------------------------------------------------------------
# The FastAPI service serves the same WebSocket contract at /ws on port 8000 and
# adds persistence. It defaults to SQLite; set DATABASE_URL to use Postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/griffin

# Optional shared secret. If set, WebSocket clients must present the same value as a
# token query parameter on the /ws URL, e.g. wss://your-backend-host/ws?token=...
# GRIFFIN_WS_TOKEN=

# Max concurrent pipeline runs the FastAPI service will accept (default 3).
# GRIFFIN_MAX_CONCURRENCY=3

# Max prompt length in characters the FastAPI service will accept (default 4000).
# GRIFFIN_MAX_PROMPT_CHARS=4000

# ----------------------------------------------------------------------------
# GitHub Integration (Optional - for auto-pushing code)
# ----------------------------------------------------------------------------
# Create a Personal Access Token at: https://github.com/settings/tokens
# Select 'repo' scope for full repository access
GITHUB_TOKEN=
GITHUB_OWNER=your_github_username

# ----------------------------------------------------------------------------
# Vercel Deployment (Optional - for auto-deployment)
# ----------------------------------------------------------------------------
# Create a token at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ----------------------------------------------------------------------------
# Application URLs
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
