# orchestrator
ORCHESTRATOR_URL=ws://localhost:9100
ORCHESTRATOR_PORT=9100

# backend
BACKEND_PORT=8000

# Groq API keys 
LLM_API_KEY=
LLM_SPECIALIST_API_KEY=

# Models — active Groq models (llama3-70b/8b were decommissioned)
LLM_PM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_SPECIALIST_MODEL=llama-3.1-8b-instant

# Groq OpenAI-compatible base URL
LLM_BASE_URL=https://api.groq.com/openai/v1

# frontend
NEXT_PUBLIC_ORCHESTRATOR_URL=ws://localhost:9100

# GitHub — auto-create repos for generated projects
# Create a Personal Access Token at https://github.com/settings/tokens (classic, with 'repo' scope)
GITHUB_TOKEN=
GITHUB_OWNER=

# Google Gemini — used by the ML Office Chain
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
