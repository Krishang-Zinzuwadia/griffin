# ============================================================================
# Griffin Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys
# This project runs locally - all data stays on your machine
# ============================================================================

# ----------------------------------------------------------------------------
# LLM Provider (Required - choose ONE)
# ----------------------------------------------------------------------------

# Option 1: Google Gemini (Recommended)
# Get your API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Option 2: OpenRouter (Alternative)
# Get your API key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# ----------------------------------------------------------------------------
# ML Service Configuration
# ----------------------------------------------------------------------------
ML_SERVICE_PORT=9100
NEXT_PUBLIC_ML_SERVICE_URL=ws://localhost:9100

# ----------------------------------------------------------------------------
# GitHub Integration (Optional - for auto-pushing code)
# ----------------------------------------------------------------------------
# Create a Personal Access Token at: https://github.com/settings/tokens
# Select 'repo' scope for full repository access
GITHUB_TOKEN=
GITHUB_OWNER=your_github_username

# ----------------------------------------------------------------------------
# Vercel Deployment (Optional - for auto-deployment)
# ----------------------------------------------------------------------------
# Create a token at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ----------------------------------------------------------------------------
# Application URLs
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
