{
  "name": "griffin",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.8"
  },
  "peerDependencies": {
    "typescript": "^5",
    "@tauri-apps/cli": "^2.9.6"
  },
  "scripts": {
    "dev": "echo \"Use dev:backend, dev:frontend, and dev:tauri in separate terminals\"",
    "dev:backend": "cd backend && ../.venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && bun next dev --turbo",
    "dev:tauri": "bun tauri dev",
    "dev:orchestrator": "cd backend/orchestrator && bun run start",
    "dev:wrapper:health": "bun run --env-file=.env backend/wrappers/health/index.ts",
    "dev:wrapper:frontend": "bun run --env-file=.env backend/wrappers/frontend-design/index.ts",
    "dev:wrapper:backend-api": "bun run --env-file=.env backend/wrappers/backend-api/index.ts",
    "dev:wrapper:security": "bun run --env-file=.env backend/wrappers/security/index.ts",
    "dev:wrapper:pm": "bun run --env-file=.env backend/wrappers/pm/index.ts",
    "tauri": "tauri"
  },
  "dependencies": {}
}