{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "griffin",
  "version": "0.1.0",
  "identifier": "com.griffin.app",
  "build": {
    "frontendDist": "../frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev:frontend",
    "beforeBuildCommand": "cd frontend && NEXT_OUTPUT_EXPORT=1 bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "griffin",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}